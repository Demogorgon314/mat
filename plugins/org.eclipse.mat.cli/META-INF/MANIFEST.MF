 org.eclipse.mat.report;bundle-version="1.17.0"
Import-Package: org.osgi.framework
Export-Package: org.eclipse.mat.cli.internal;x-friends:="org.eclipse.mat.tests",
 org.eclipse.mat.cli.internal.serialization;x-friends:="org.eclipse.mat.tests"
Bundle-ActivationPolicy: lazy

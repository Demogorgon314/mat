#!/bin/sh
#
# Run the Eclipse Memory Analyzer CLI application.
#

DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
JAVA_CMD=java
LAUNCHER_JAR=

if [ -n "$JAVA_HOME" ]; then
    JAVA_CMD="$JAVA_HOME/bin/java"
fi

for candidate in "$DIR"/plugins/org.eclipse.equinox.launcher_*.jar
do
    if [ -f "$candidate" ]; then
        LAUNCHER_JAR="$candidate"
        break
    fi
done

if [ -z "$LAUNCHER_JAR" ]; then
    echo "Unable to locate org.eclipse.equinox.launcher_*.jar under $DIR/plugins" >&2
    exit 1
fi

read_product_version() {
    if [ -f "$DIR/.eclipseproduct" ]; then
        version=$(sed -n 's/^version=//p' "$DIR/.eclipseproduct" | sed -n '1p')
        if [ -n "$version" ]; then
            printf '%s\n' "$version"
            return
        fi
    fi

    printf '%s\n' "unknown"
}

read_install_token() {
    for candidate in "$DIR"/plugins/org.eclipse.mat.cli_*.jar
    do
        if [ -f "$candidate" ]; then
            token=${candidate##*/}
            token=${token#org.eclipse.mat.cli_}
            token=${token%.jar}
            printf '%s\n' "$token"
            return
        fi
    done

    printf '%s\n' "$PRODUCT_VERSION"
}

normalize_os() {
    case "$1" in
        Darwin)
            printf '%s\n' "macosx"
            ;;
        Linux)
            printf '%s\n' "linux"
            ;;
        *)
            printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]'
            ;;
    esac
}

normalize_arch() {
    case "$1" in
        arm64)
            printf '%s\n' "aarch64"
            ;;
        amd64)
            printf '%s\n' "x86_64"
            ;;
        *)
            printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]'
            ;;
    esac
}

PRODUCT_VERSION=$(read_product_version)
INSTALL_TOKEN=$(read_install_token)
OS_ID=$(normalize_os "${MAT_CLI_OS_ID:-$(uname -s 2>/dev/null || printf '%s' unknown)}")
ARCH_ID=$(normalize_arch "${MAT_CLI_ARCH_ID:-$(uname -m 2>/dev/null || printf '%s' unknown)}")
RUNTIME_ID="v3-${PRODUCT_VERSION}-${INSTALL_TOKEN}-${OS_ID}-${ARCH_ID}"

if [ -n "$MAT_CLI_CONFIG_DIR" ]; then
    CONFIG_DIR="$MAT_CLI_CONFIG_DIR"
    CONFIG_DIR_EXPLICIT=1
elif [ -n "$XDG_CACHE_HOME" ]; then
    CONFIG_DIR="$XDG_CACHE_HOME/mat-cli/$RUNTIME_ID/configuration"
    CONFIG_DIR_EXPLICIT=0
elif [ -n "$HOME" ]; then
    CONFIG_DIR="$HOME/.cache/mat-cli/$RUNTIME_ID/configuration"
    CONFIG_DIR_EXPLICIT=0
else
    CONFIG_DIR="${TMPDIR:-/tmp}/mat-cli-${USER:-user}/$RUNTIME_ID/configuration"
    CONFIG_DIR_EXPLICIT=0
fi

if [ -n "$MAT_CLI_DATA_DIR" ]; then
    DATA_DIR="$MAT_CLI_DATA_DIR"
    DATA_DIR_EXPLICIT=1
elif [ -n "$XDG_STATE_HOME" ]; then
    DATA_DIR="$XDG_STATE_HOME/mat-cli/$RUNTIME_ID/workspace"
    DATA_DIR_EXPLICIT=0
elif [ -n "$HOME" ]; then
    DATA_DIR="$HOME/.local/state/mat-cli/$RUNTIME_ID/workspace"
    DATA_DIR_EXPLICIT=0
else
    DATA_DIR="${TMPDIR:-/tmp}/mat-cli-${USER:-user}/$RUNTIME_ID/workspace"
    DATA_DIR_EXPLICIT=0
fi

if ! mkdir -p "$CONFIG_DIR" "$DATA_DIR" 2>/dev/null; then
    if [ "$CONFIG_DIR_EXPLICIT" -ne 0 ] || [ "$DATA_DIR_EXPLICIT" -ne 0 ]; then
        echo "Unable to create writable runtime directories: $CONFIG_DIR and $DATA_DIR" >&2
        exit 1
    fi

    CONFIG_DIR="${TMPDIR:-/tmp}/mat-cli-${USER:-user}/$RUNTIME_ID/configuration"
    DATA_DIR="${TMPDIR:-/tmp}/mat-cli-${USER:-user}/$RUNTIME_ID/workspace"
fi

if ! mkdir -p "$CONFIG_DIR" "$DATA_DIR"; then
    echo "Unable to create writable runtime directories: $CONFIG_DIR and $DATA_DIR" >&2
    exit 1
fi

if [ -n "$MAT_CLI_VMARGS" ]; then
    exec "$JAVA_CMD" $MAT_CLI_VMARGS -jar "$LAUNCHER_JAR" -configuration "$CONFIG_DIR" -data "$DATA_DIR" -nosplash -product org.eclipse.mat.cli.product -application org.eclipse.mat.cli.app "$@"
fi

exec "$JAVA_CMD" -Xmx1024m -jar "$LAUNCHER_JAR" -configuration "$CONFIG_DIR" -data "$DATA_DIR" -nosplash -product org.eclipse.mat.cli.product -application org.eclipse.mat.cli.app "$@"

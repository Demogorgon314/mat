_mat_cli_option_kind() {
    local kind
    kind="$(_mat_cli_option_kind_for_command "$1" "$2")"
    if [ -n "$kind" ]; then
        printf '%s\n' "$kind"
        return 0
    fi
    _mat_cli_option_kind_global "$2"
}

